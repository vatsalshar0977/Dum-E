<?xml version="1.0"?>
<!-- Schematic kinematic model; collision boxes are NOT CAD geometry or a safety guarantee. Units: m, rad, kg. -->
<robot name="bude_prototype">
  <link name="base_link"><visual><geometry><box size="0.10 0.10 0.04"/></geometry></visual><collision><geometry><box size="0.10 0.10 0.04"/></geometry></collision><inertial><mass value="0.25"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial></link>
  <link name="turret"><visual><geometry><box size="0.06 0.05 0.04"/></geometry></visual><collision><geometry><box size="0.06 0.05 0.04"/></geometry></collision><inertial><mass value="0.10"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial></link>
  <link name="upper_arm"><visual><origin xyz="0 0 0.04"/><geometry><box size="0.025 0.025 0.08"/></geometry></visual><collision><origin xyz="0 0 0.04"/><geometry><box size="0.025 0.025 0.08"/></geometry></collision><inertial><origin xyz="0 0 0.04"/><mass value="0.09"/><inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00001"/></inertial></link>
  <link name="forearm"><visual><origin xyz="0 0 0.0375"/><geometry><box size="0.020 0.020 0.075"/></geometry></visual><collision><origin xyz="0 0 0.0375"/><geometry><box size="0.020 0.020 0.075"/></geometry></collision><inertial><origin xyz="0 0 0.0375"/><mass value="0.05"/><inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.000008"/></inertial></link>
  <link name="wrist"><visual><origin xyz="0 0 0.011"/><geometry><box size="0.020 0.020 0.022"/></geometry></visual><collision><origin xyz="0 0 0.011"/><geometry><box size="0.020 0.020 0.022"/></geometry></collision><inertial><origin xyz="0 0 0.011"/><mass value="0.025"/><inertia ixx="0.000006" ixy="0" ixz="0" iyy="0.000006" iyz="0" izz="0.000006"/></inertial></link>
  <link name="hand"><visual><origin xyz="0 0 0.024"/><geometry><box size="0.026 0.03 0.048"/></geometry></visual><collision><origin xyz="0 0 0.024"/><geometry><box size="0.026 0.03 0.048"/></geometry></collision><inertial><origin xyz="0 0 0.024"/><mass value="0.04"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial></link>
  <link name="tcp_link"><inertial><mass value="0.001"/><inertia ixx="0.00000001" ixy="0" ixz="0" iyy="0.00000001" iyz="0" izz="0.00000001"/></inertial></link>
  <joint name="base_yaw" type="revolute"><parent link="base_link"/><child link="turret"/><origin xyz="0 0 0.055"/><axis xyz="0 0 1"/><limit lower="-1.570796" upper="1.570796" effort="0.3" velocity="0.8"/></joint>
  <!-- Each pitch axis is +Y: at 0 links point straight up, positive bends forward -->
  <joint name="shoulder_pitch" type="revolute"><parent link="turret"/><child link="upper_arm"/><axis xyz="0 1 0"/><limit lower="-1.308997" upper="1.483530" effort="0.3" velocity="0.8"/></joint>
  <joint name="elbow_pitch" type="revolute"><parent link="upper_arm"/><child link="forearm"/><origin xyz="0 0 0.08"/><axis xyz="0 1 0"/><limit lower="-1.570796" upper="1.570796" effort="0.3" velocity="0.8"/></joint>
  <joint name="wrist_pitch" type="revolute"><parent link="forearm"/><child link="wrist"/><origin xyz="0 0 0.075"/><axis xyz="0 1 0"/><limit lower="-1.483530" upper="1.483530" effort="0.08" velocity="0.8"/></joint>
  <joint name="wrist_roll" type="revolute"><parent link="wrist"/><child link="hand"/><origin xyz="0 0 0.022"/><axis xyz="0 0 1"/><limit lower="-1.570796" upper="1.570796" effort="0.08" velocity="0.8"/></joint>
  <joint name="tcp_fixed" type="fixed"><parent link="hand"/><child link="tcp_link"/><origin xyz="0 0 0.048"/></joint>
</robot>
